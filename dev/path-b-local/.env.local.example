# SAR-402 Path B — LOCAL DEVELOPMENT PROFILE
#
# DEVELOPMENT ONLY. Not for production. Not compatible with production key
# registries (defaultverifier.com/.well-known/sar-keys.json publishes only
# defaultverifier-recording-ed25519-1 / -2 — this dev kid is never listed
# there and never will be).
#
# Copy this file to .env.local (gitignored) and fill in the public key hex
# printed by generate_dev_key.py. Never put a private key value in this file
# directly — PATH_B_RECORDING_PRIVATE_KEY_FILE points at the credential file
# on disk; the loader reads the key from there, not from this env file.

PATH_B_RECORDING_KID=defaultverifier-recording-dev-ed25519-1

PATH_B_RECORDING_PUBLIC_KEY_HEX=<dev-public-key-hex-from-generate_dev_key.py>

PATH_B_RECORDING_PRIVATE_KEY_FILE=.local-credentials/path-b-recording-dev-key
